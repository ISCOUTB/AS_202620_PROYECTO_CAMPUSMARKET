# Introducir valores directamente en Environment o deploy/.env ignorado por Git.
# Sin contraseñas por defecto: Compose exige ambas.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=campusmarket
MYSQL_USER=campusmarket_app
CAMPUSMARKET_ADMIN_USER_IDS=
CAMPUSMARKET_CORS_ORIGINS=
# SHA completo del commit aprobado; es configuración pública.
CAMPUSMARKET_REVISION=development
