{
  "openapi": "3.1.0",
  "info": {
    "title": "CampusMarket API",
    "description": "API HTTP/JSON de CampusMarket para crear y consultar publicaciones. El contrato versionado es contracts/openapi-v1.json.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Entorno local"
    }
  ],
  "paths": {
    "/publicaciones": {
      "get": {
        "tags": [
          "publicaciones"
        ],
        "summary": "Listar publicaciones",
        "operationId": "listarPublicaciones",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Publicacion"
                  },
                  "type": "array",
                  "title": "Response Listarpublicaciones"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "publicaciones"
        ],
        "summary": "Crear una publicación",
        "operationId": "crearPublicacion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicacionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publicacion"
                }
              }
            }
          },
          "503": {
            "description": "Persistencia temporalmente no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Consultar la salud del backend",
        "operationId": "consultarSalud",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "Publicacion": {
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Titulo"
          },
          "descripcion": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Descripcion"
          },
          "precio": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Precio"
          },
          "modalidad": {
            "type": "string",
            "enum": [
              "venta",
              "alquiler"
            ],
            "title": "Modalidad"
          },
          "estado": {
            "type": "string",
            "enum": [
              "nuevo",
              "usado",
              "reacondicionado"
            ],
            "title": "Estado"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "titulo",
          "descripcion",
          "precio",
          "modalidad",
          "estado",
          "id"
        ],
        "title": "Publicacion"
      },
      "PublicacionCreate": {
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Titulo"
          },
          "descripcion": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Descripcion"
          },
          "precio": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Precio"
          },
          "modalidad": {
            "type": "string",
            "enum": [
              "venta",
              "alquiler"
            ],
            "title": "Modalidad"
          },
          "estado": {
            "type": "string",
            "enum": [
              "nuevo",
              "usado",
              "reacondicionado"
            ],
            "title": "Estado"
          }
        },
        "type": "object",
        "required": [
          "titulo",
          "descripcion",
          "precio",
          "modalidad",
          "estado"
        ],
        "title": "PublicacionCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
