{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicacionCreada v1 — simulación de notificación",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_id",
    "correlation_id",
    "publication_id",
    "title",
    "schema_version"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "publication_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    }
  }
}
